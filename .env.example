# ============================================================================
# Plantão 360 — arquivo ÚNICO de configuração (copie para .env e preencha).
#
# É o único lugar onde se mexe no servidor. Para atualizar a aplicação basta
# trocar APP_VERSION abaixo e rodar:
#   docker compose down; docker compose pull; docker compose up -d
# ============================================================================

# ---- Versão da imagem a rodar (tag publicada no GHCR, ex.: 1.6.0) ----
APP_VERSION=1.6.0

APP_NAME=Plantao360
ENVIRONMENT=production

# ---- Banco de dados (PostgreSQL, serviço "db") ----
# A DATABASE_URL é montada pelo docker-compose.yml a partir destas três variáveis.
# ATENÇÃO: a senha vai dentro de uma URL — não use os caracteres @ : / nela.
POSTGRES_USER=plantao360
POSTGRES_PASSWORD=
POSTGRES_DB=plantao360

# ---- Segurança ----
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em produção o startup ABORTA se SECRET_KEY for o valor de exemplo (< 32 chars)
# ou se ADMIN_PASSWORD for uma senha padrão (< 8 chars).
SECRET_KEY=
ADMIN_EMAIL=admin@plantao360.local
ADMIN_PASSWORD=

# ---- Porta pública (só o frontend/nginx é exposto) ----
FRONTEND_PORT=3001

# ---- Logging / CORS ----
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# ---- Feature flags ----
ENABLE_JWT=false
ENABLE_AUDIT_LOG=false
ENABLE_BI=false
ENABLE_ANALYTICS=false
ENABLE_TASY_INTEGRATION=false
ENABLE_EXPORT_PDF=false
ENABLE_IMPORT_LEGACY=false
# Produção NUNCA semeia automaticamente (seed é comando manual).
DEMO_MODE=false
